# EditorConfig keeps indentation and line endings consistent across editors.
# It complements .gitattributes, which enforces the same line endings in git.
# See https://editorconfig.org -- most editors need a plugin to honor this.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html,htm,svg}]
indent_size = 2

[*.{sh,bash,rb}]
indent_size = 2

[*.{py,go}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

# These must keep CRLF on checkout -- see .gitattributes. EditorConfig does
# expand {a,b} braces; git attribute patterns do not, so the two files spell
# the same rule differently on purpose.
[*.{csv,ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf
